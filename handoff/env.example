# Backend (.env) — values come from the hosting environment; no defaults in code
MONGO_URL=                 # existing site value
DB_NAME=                   # existing site value
APP_ORIGIN=https://thedoxs.com      # browser origin; used for CSRF origin checks and reset links
CORS_ORIGINS=https://thedoxs.com
JWT_SECRET=                # only if the workspace's own JWT auth is kept; drop after auth swap
EMERGENT_LLM_KEY=          # GPT-5.2 gateway + private object storage (Emergent universal key)
EMERGENT_EMAIL_KEY=        # managed Resend (password reset) — drop if the site owns password reset
EMAIL_FROM_NAME=D.O.X Workspace
EMAIL_REPLY_TO=
# Remove after merge (workspace self-auth only):
# INITIAL_OWNER_EMAIL=
# INITIAL_OWNER_PASSWORD=

# Frontend (.env)
REACT_APP_BACKEND_URL=https://thedoxs.com   # same origin as the site; all calls go to ${REACT_APP_BACKEND_URL}/api
